{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.{test,spec,bench}.ts",
        "typedoc.json",
        ".size-limit.json",
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ],
      "ignore": [
        "tests/consumer/**"
      ],
      "ignoreBinaries": [
        "xmllint",
        "python3",
        "svelte-kit"
      ]
    },
    "site": {
      "entry": [
        "src/**/*.{ts,svelte}"
      ],
      "project": [
        "src/**/*.{ts,svelte}"
      ]
    }
  }
}
